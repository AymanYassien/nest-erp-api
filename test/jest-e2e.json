{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/utils/load-test-env.ts"],
  "globalSetup": "<rootDir>/utils/global-setup.ts",
  "testTimeout": 20000
}
